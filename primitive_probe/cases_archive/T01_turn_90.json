{
  "id": "T01_turn_90",
  "adapter": "turn",
  "title": "行旋转 1 个四分之一圈（90° 逆时针）",
  "purpose": "输入非对称形状（左侧多晶条 + 右上角 M1 方块），观察旋转方向与原点归一化。青色为未旋转输入（平移到左侧显示）。",
  "expect_rejection": false,
  "params": {
    "row": {
      "layers": {
        "active": [
          [
            0,
            0,
            2000,
            1000
          ]
        ],
        "poly": [
          [
            0,
            0,
            400,
            1000
          ]
        ],
        "metal1": [
          [
            1700,
            700,
            1900,
            900
          ]
        ]
      },
      "terminals": [
        [
          "TOPRIGHT",
          [
            1700,
            700,
            1900,
            900
          ]
        ]
      ]
    },
    "quarter_turns": 1,
    "display_offset_nm": [
      -4000,
      0
    ]
  },
  "expected": {
    "derivation": "KLayout r90 = 逆时针 90°：(x,y)→(−y,x)；随后平移使有源区左下角回到 (0,0)。",
    "statements": [
      "有源区变为 1000 宽 × 2000 高，位于 (0,0)–(1000,2000)。",
      "原左侧多晶条移到底部：(0,0)–(1000,400)。",
      "原右上 M1 方块移到左上：(100,1700)–(300,1900)，文本 TOPRIGHT 随之移动。"
    ],
    "shapes": [
      {
        "bbox_nm": [
          0,
          0,
          1000,
          2000
        ],
        "label": "有源区"
      },
      {
        "bbox_nm": [
          0,
          0,
          1000,
          400
        ],
        "label": "多晶条"
      },
      {
        "bbox_nm": [
          100,
          1700,
          300,
          1900
        ],
        "label": "M1"
      }
    ]
  }
}
