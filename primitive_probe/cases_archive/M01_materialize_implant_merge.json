{
  "id": "M01_materialize_implant_merge",
  "adapter": "materialize",
  "title": "组装：平移 + 同层注入合并",
  "purpose": "两个相同的行（有源区 + N+）放在不同原点，观察 materialize 的平移和注入/标记层合并行为。",
  "expect_rejection": false,
  "params": {
    "rows": {
      "R1": {
        "layers": {
          "active": [
            [
              0,
              0,
              1000,
              1000
            ]
          ],
          "nplus": [
            [
              -230,
              -230,
              1230,
              1230
            ]
          ]
        },
        "terminals": [
          [
            "NET1",
            [
              400,
              400,
              600,
              600
            ]
          ]
        ]
      },
      "R2": {
        "layers": {
          "active": [
            [
              0,
              0,
              1000,
              1000
            ]
          ],
          "nplus": [
            [
              -230,
              -230,
              1230,
              1230
            ]
          ]
        },
        "terminals": [
          [
            "NET2",
            [
              400,
              400,
              600,
              600
            ]
          ]
        ]
      }
    },
    "origins": {
      "R1": [
        0,
        0
      ],
      "R2": [
        3000,
        0
      ]
    }
  },
  "expected": {
    "derivation": "materialize 注释：nwell、nplus、pplus、dualgate、v5_xtor 同层合并为外接矩形；其余层只平移。",
    "statements": [
      "22/0 两个独立有源区：(0,0)–(1000,1000) 与 (3000,0)–(4000,1000)。",
      "32/0 N+ 只有 1 个矩形 (-230,-230)–(4230,1230)，覆盖两行之间的空隙。",
      "0/0 边界 = (-230,-230)–(4230,1230)。",
      "34/10 文本 NET1 位于 (500,500)，NET2 位于 (3500,500)。"
    ],
    "shapes": [
      {
        "bbox_nm": [
          -230,
          -230,
          4230,
          1230
        ],
        "label": "合并后的 N+"
      }
    ]
  }
}
