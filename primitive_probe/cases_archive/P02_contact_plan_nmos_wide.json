{
  "id": "P02_contact_plan_nmos_wide",
  "adapter": "contact_plan",
  "title": "接触规划器：宽 NMOS（高于阈值 → 2 行）",
  "expect_rejection": false,
  "params": {
    "library": {
      "schema": "clay.contact-primitive.v1",
      "pdk": "gf180mcu_5v",
      "patterns": {
        "nmos": [
          {
            "gate_count": 1,
            "segments": [
              "output",
              "rail"
            ]
          },
          {
            "gate_count": 2,
            "segments": [
              "rail",
              "output",
              "rail"
            ]
          }
        ],
        "pmos": [
          {
            "gate_count": 1,
            "segments": [
              "output",
              "rail"
            ]
          },
          {
            "gate_count": 2,
            "segments": [
              "rail",
              "output",
              "rail"
            ]
          }
        ]
      },
      "contact_policies": {
        "nmos": {
          "rows": {
            "kind": "width_stump",
            "threshold_nm": 1070.0,
            "low": 1,
            "high": 2
          },
          "first_contact_free_margin_fraction": 0.5
        },
        "pmos": {
          "rows": {
            "kind": "constant",
            "count": 2
          },
          "first_contact_free_margin_fraction": 0.5
        }
      },
      "binding": "target_W_L_models_and_nets",
      "operator": "rectangular_diffusion_chain_v1"
    },
    "kind": "nmos",
    "w_nm": 1830,
    "l_nm": 600,
    "chain": [
      "output",
      "rail"
    ],
    "nets": {
      "gate": "IN",
      "output": "OUT",
      "rail": "VSS"
    }
  },
  "expected": {
    "derivation": "同 P01。n=2 时区间 [180, 1830−180−470] = [180,1180]。",
    "statements": [
      "count = 2（W 1830 > 1070）。",
      "centers_nm = [680, 1150]：首孔 180 + 0.5×1000 = 680，孔距 470。",
      "GDS 中每个 S/D 段 2 个孔，y = 680 和 1150。"
    ]
  }
}
