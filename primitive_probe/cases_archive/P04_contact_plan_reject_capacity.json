    "kind": "nmos",
    "w_nm": 1000,
    "l_nm": 600,
    "chain": [
      "output",
      "rail"
    ],
    "nets": {
      "gate": "IN",
      "output": "OUT",
      "rail": "VSS"
    }
  },
  "expected": {
    "derivation": "3 孔需 3×220 + 2×250 + 2×70 = 1300 > W 1000。",
    "statements": [
      "工程代码抛出 ValueError（孔数超过物理容量），不生成 GDS。"
    ]
  }
}
