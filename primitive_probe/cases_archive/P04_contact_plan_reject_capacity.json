{
  "id": "P04_contact_plan_reject_capacity",
  "adapter": "contact_plan",
  "title": "负对照：预测孔数超过物理容量",
  "expect_rejection": true,
  "params": {
    "library": {
      "schema": "clay.contact-primitive.v1",
      "pdk": "gf180mcu_5v",
      "patterns": {
        "nmos": [
          {
            "gate_count": 1,
            "segments": [
              "output",
              "rail"
            ]
          },
          {
            "gate_count": 2,
            "segments": [
              "rail",
              "output",
              "rail"
            ]
          }
        ],
        "pmos": [
          {
            "gate_count": 1,
            "segments": [
              "output",
              "rail"
            ]
          },
          {
            "gate_count": 2,
            "segments": [
              "rail",
              "output",
              "rail"
            ]
          }
        ]
      },
      "contact_policies": {
        "nmos": {
          "rows": {
            "kind": "constant",
            "count": 3
          },
          "first_contact_free_margin_fraction": 0.5
        },
        "pmos": {
          "rows": {
            "kind": "constant",
            "count": 2
          },
          "first_contact_free_margin_fraction": 0.5
        }
      },
      "binding": "target_W_L_models_and_nets",
      "operator": "rectangular_diffusion_chain_v1"
